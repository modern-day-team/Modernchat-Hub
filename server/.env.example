# 服务监听端口
PORT=8091

# gin 运行模式：release（默认，生产口径）| debug | test
GIN_MODE=release

# MySQL 连接串（默认对接 docker-compose：3308 端口、库 modernchat_hub）
# 本机原生 MySQL（3306）的备选写法：
# DB_DSN=root:<你的密码>@tcp(127.0.0.1:3306)/modernchat_hub?charset=utf8mb4&parseTime=true&loc=Local
DB_DSN=root:modernchat_hub_dev@tcp(127.0.0.1:3308)/modernchat_hub?charset=utf8mb4&parseTime=true&loc=Local

# JWT 签名密钥：必填，≥32 字节，用 openssl rand -hex 32 生成
JWT_SECRET=

# Cookie 安全标记：本地 HTTP 开发用 false；HTTPS 部署改 true
COOKIE_SECURE=false

# 服务凭据加密密钥：可选，缺省由 JWT_SECRET 派生（mc-hub-cred-v1: 前缀）
CRED_SECRET=
